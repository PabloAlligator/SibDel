{
  "name": "siberian-delicacies",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce platform Siberian Delicacies",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "admin:create-owner": "node prisma/create-owner.js",
    "css": "sass site/scss/main.scss site/css/main.css --style=expanded --no-source-map",
    "css:watch": "sass --watch site/scss/main.scss:site/css/main.css --style=expanded --no-source-map",
    "security:audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "sass": "^1.103.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.22.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
